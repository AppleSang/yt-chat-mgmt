{
  "manifest_version": 3,
  "name": "yt-chat-mgmt",
  "short_name": "yt-chat-mgmt",
  "description": "Clear commands, hide bot messages, enhance live chat YouTube and support 7TV!",
  "version": "1.0.124",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://7tv.io/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*", "icons/*", "emotes.json", "popup/*"],
      "matches": ["https://*.youtube.com/*"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
